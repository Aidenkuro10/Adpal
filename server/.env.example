# AdPal — simulator configuration
# Copy this file to `.env`, then adjust values as needed.

# Development serves every page and asset with `Cache-Control: no-store` and
# content-hashed URLs (`style.css?v=<hash>`), so editing a stylesheet and
# refreshing normally is enough — no hard refresh. Set NODE_ENV=production to
# enable normal revalidation and long-lived caching for `?v=` assets instead.
# NODE_ENV=production

# Express server port
PORT=3000

# If PORT is already taken, try this many following ports (3001, 3002, …)
# before giving up. The extension discovers the active port automatically.
PORT_SCAN_RANGE=10

# Grouped payout threshold (in euros).
# 0.05 is deliberately low: four verified impressions (4 × €0.014 = €0.056)
# cross it, so a full read of the demo article can be settled immediately.
PAYOUT_THRESHOLD=0.05

# Maximum price accepted for a single offer (server-side guard rail)
MAX_OFFER_PRICE=0.05

# Default offer price (informational, exposed through the rules)
DEFAULT_OFFER_PRICE=0.02

# Share paid to the user (the remainder goes to the publisher)
USER_SHARE=0.7

# Simulated initial advertiser budget
ADVERTISER_BUDGET=50

# Minimum score (0-100) required to approve an offer as human
HUMAN_THRESHOLD=50

# ---------------------------------------------------------------------------
# PayPal Payouts (REST API)
# ---------------------------------------------------------------------------
# Create an app at https://developer.paypal.com/dashboard/applications and copy
# its Sandbox client id / secret here. `sandbox` targets api-m.sandbox.paypal.com,
# `live` targets api-m.paypal.com. Only sandbox is used by the demo.
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Business Sandbox account the payouts are sent from (sender).
PAYPAL_BUSINESS_EMAIL=sb-jokak53538300@business.example.com

# Recipient of the reader share. Defaults to the business account above so the
# demo works out of the box; point it at a personal Sandbox account to watch the
# money arrive there instead.
PAYPAL_RECEIVER_EMAIL=sb-jokak53538300@business.example.com

# Optional second receiver for the publisher's 30% share. Defaults to the
# business account above, which PayPal accepts as a batch item, so the 70/30
# split is actually moved instead of being left on the ledger. Set it to any
# distinct Sandbox email to pay that account instead.
PAYPAL_PUBLISHER_EMAIL=sb-jokak53538300@business.example.com

# Payout currency and the maximum a single demo payout may move (guard rail).
PAYPAL_CURRENCY=EUR
PAYPAL_MAX_PAYOUT=5

# Abort a PayPal HTTP call after this many milliseconds.
PAYPAL_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# Automatic settlement (L402 → PayPal Payouts)
# ---------------------------------------------------------------------------
# When attention proof settles an invoice and the reader balance crosses
# PAYOUT_THRESHOLD, the protocol agent creates the Payouts batch automatically.
# Set to false to keep settlement manual (terminal button / extension popup).
PAYPAL_AUTO_PAYOUT=true
# Small pause so the terminal shows the settlement and the batch separately.
PAYPAL_AUTO_PAYOUT_DELAY_MS=900
# Never create two batches back to back within this window.
PAYPAL_AUTO_PAYOUT_MIN_INTERVAL_MS=15000

# ---------------------------------------------------------------------------
# PayPal webhooks (POST /api/webhooks/paypal)
# ---------------------------------------------------------------------------
# Webhook id from the PayPal dashboard for the URL above. Signature
# verification is a round-trip to PayPal's verify-webhook-signature API and
# needs this id. Leave it empty and events are still accepted, but the receipt
# honestly says signature="skipped" instead of pretending to have checked.
PAYPAL_WEBHOOK_ID=
# true refuses unverified notifications with 503. Use this anywhere that is
# not a sandbox demo.
PAYPAL_WEBHOOK_STRICT=false
# Event ids remembered to suppress PayPal's retries.
PAYPAL_WEBHOOK_REPLAY_WINDOW=500

# ---------------------------------------------------------------------------
# Solana Devnet (on-chain settlement + L402 proof anchoring)
# ---------------------------------------------------------------------------
# Which rail pays out automatically:
#   paypal_payouts � PayPal Sandbox Payouts batch (see above)
#   solana-devnet  � a single devnet transaction with both 70/30 legs
# Both stay callable per request via POST /api/payout { "rail": "..." }.
PAYOUT_RAIL=paypal_payouts

SOLANA_ENABLED=true
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Native SOL by default. Set SOLANA_MINT to an SPL mint (e.g. devnet USDC,
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU) to pay in that token instead.
SOLANA_CURRENCY=SOL
SOLANA_MINT=
SOLANA_DECIMALS=9

# Base units per euro. One euro of attention is worth this many lamports (or
# token base units). Keep it an integer so every payout amount maps to a whole
# number of units with no float drift. 100000000 = 0.1 SOL per euro.
SOLANA_UNITS_PER_EUR=100000000

# Treasury keypair. Accepts a base58 secret key or the JSON byte array written by
# `solana-keygen`. Leave empty and the server generates one, persisting it to
# SOLANA_KEYPAIR_FILE (server/.solana-devnet-keys.json) so the address is stable.
SOLANA_TREASURY_SECRET=

# Optional fixed destinations for the reader and publisher legs. When empty,
# the generated demo keypairs are used (so the transfer is real, on-chain, and
# both legs are visible in the explorer).
SOLANA_READER_ADDRESS=
SOLANA_PUBLISHER_ADDRESS=

# Devnet faucet: keeps the demo self-funding. The public faucet is rate-limited
# per IP, so a failed airdrop is reported with the treasury address to fund.
SOLANA_AIRDROP=true
SOLANA_AIRDROP_SOL=1

# Anchor sha256(preimage) on-chain when an L402 invoice settles.
SOLANA_ANCHOR_PROOFS=true
SOLANA_ANCHOR_TIMEOUT_MS=8000
SOLANA_TIMEOUT_MS=15000

# Guard rail for a single demo payout, and whether to fall back to PayPal when
# the devnet transfer cannot be confirmed.
SOLANA_MAX_PAYOUT=5
SOLANA_FALLBACK_TO_PAYPAL=true
