# AdPal — simulator configuration
# Copy this file to `.env`, then adjust values as needed.

# Development serves every page and asset with `Cache-Control: no-store` and
# content-hashed URLs (`style.css?v=<hash>`), so editing a stylesheet and
# refreshing normally is enough — no hard refresh. Set NODE_ENV=production to
# enable normal revalidation and long-lived caching for `?v=` assets instead.
# NODE_ENV=production

# Express server port
PORT=3000

# If PORT is already taken, try this many following ports (3001, 3002, …)
# before giving up. The extension discovers the active port automatically.
PORT_SCAN_RANGE=10

# Grouped payout threshold (in euros).
# One verified impression (€0.70 reader share at a €1.00 price) crosses it, so
# an approved impression can be settled immediately.
PAYOUT_THRESHOLD=0.005

# Maximum price accepted for a single offer (server-side guard rail).
# Must be >= DEFAULT_OFFER_PRICE or the default is clamped down to it.
MAX_OFFER_PRICE=1.00

# Default offer price (informational, exposed through the rules).
# €1.00 per impression → €0.70 reader / €0.30 publisher.
DEFAULT_OFFER_PRICE=1.00

# Share paid to the user (the remainder goes to the publisher)
USER_SHARE=0.7

# Simulated initial advertiser budget
ADVERTISER_BUDGET=50

# Minimum score (0-100) required to approve an offer as human
HUMAN_THRESHOLD=50

# ---------------------------------------------------------------------------
# PayPal Payouts (REST API)
# ---------------------------------------------------------------------------
# Create an app at https://developer.paypal.com/dashboard/applications and copy
# its Sandbox client id / secret here. `sandbox` targets api-m.sandbox.paypal.com,
# `live` targets api-m.paypal.com. Only sandbox is used by the demo.
PAYPAL_MODE=sandbox
# Sandbox is enforced. PAYPAL_MODE=live is ignored unless this is true, because
# flipping it also moves the API host, the certificate host and which webhook ids
# are valid — a half-flipped environment verifies nothing and retries forever.
PAYPAL_ALLOW_LIVE=false
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Business Sandbox account the payouts are sent from (sender). PayPal refuses a
# payout to this account, so no receiver below may resolve to it.
PAYPAL_BUSINESS_EMAIL=sb-jokak53538300@business.example.com

# Every other confirmed email on the business account. PayPal identifies the
# payer by account, not by address, so an alias here is still a self-payment.
# Comma-separated. Leave empty when the business account has one email.
PAYPAL_SENDER_ALIASES=

# Recipient of the reader share. Must be a different PayPal account than
# PAYPAL_BUSINESS_EMAIL: a batch cannot pay its own sender (PayPal answers
# SELF_PAY_NOT_ALLOWED and rejects the whole batch). Point it at a personal
# Sandbox account. If it resolves to the sender, the payout is refused before
# submission and no balance is touched.
PAYPAL_RECEIVER_EMAIL=sb-4s4343f53552455@personal.example.com

# Receiver of the publisher's 30% share in the same batch. Empty by default.
#
# It must be a third, distinct account. Leaving it empty does not lose the 30%:
# the share stays accrued on the ledger (nothing is debited without a transfer),
# where a later publisher settlement can pay it. Setting it to the business
# account — the sender — is ignored, because PayPal rejects that batch item and
# takes the reader's 70% down with it.
PAYPAL_PUBLISHER_EMAIL=

# Payout currency and the maximum a single demo payout may move (guard rail).
PAYPAL_CURRENCY=EUR
PAYPAL_MAX_PAYOUT=5

# Abort a PayPal HTTP call after this many milliseconds.
PAYPAL_TIMEOUT_MS=15000

# When PayPal refuses the credentials (invalid_client — almost always because
# the client id/secret belong to the other environment), do not ask again for
# this long. PayPal retries a refused webhook, so without this every retry buys
# another failed token call against an endpoint that is already unhappy.
PAYPAL_AUTH_BACKOFF_MS=30000

# The public origin PayPal should call. Used only to warn when the registered
# webhook URL no longer points at this deployment. Render injects
# RENDER_EXTERNAL_URL automatically; set this anywhere else (no trailing slash).
# PUBLIC_BASE_URL=https://your-app.onrender.com

# ---------------------------------------------------------------------------
# Automatic settlement (L402 → PayPal Payouts)
# ---------------------------------------------------------------------------
# When attention proof settles an invoice and the reader balance crosses
# PAYOUT_THRESHOLD, the protocol agent creates the Payouts batch automatically.
# Set to false to keep settlement manual (terminal button / extension popup).
PAYPAL_AUTO_PAYOUT=true
# No artificial pause. Settlement and batch are already distinct events; a
# delay only makes the terminal look laggy. 0 = same tick.
PAYPAL_AUTO_PAYOUT_DELAY_MS=0
# Never create two batches back to back within this window.
PAYPAL_AUTO_PAYOUT_MIN_INTERVAL_MS=0

# ---------------------------------------------------------------------------
# Reader presence (what makes an impression possible at all)
# ---------------------------------------------------------------------------
# A /demo/ session must heartbeat within this window to count as a live reader.
# The content script pings every 4 s while the tab is visible.
PRESENCE_TTL_MS=12000
# When true, POST /api/offer refuses a client with no live session, and an
# auto payout is abandoned if the reader leaves before it executes. Turning
# this off reintroduces ghost impressions — use it only for scripted checks.
PRESENCE_REQUIRED=true

# ---------------------------------------------------------------------------
# PayPal webhooks (POST /api/webhooks/paypal)
# ---------------------------------------------------------------------------
# Webhook id from the PayPal dashboard for the URL above. Signature
# verification is a round-trip to PayPal's verify-webhook-signature API and
# needs this id. Leave it empty and events are still accepted, but the receipt
# honestly says signature="skipped" instead of pretending to have checked.
# The id is registered per environment: a Sandbox id can never verify a Live
# delivery. Run `npm run check:paypal-env` to prove the id, the credentials and
# the API host all belong together before blaming the signature.
PAYPAL_WEBHOOK_ID=
# true refuses unverified notifications with 503. Use this anywhere that is
# not a sandbox demo.
PAYPAL_WEBHOOK_STRICT=false
# Event ids remembered to suppress PayPal's retries.
PAYPAL_WEBHOOK_REPLAY_WINDOW=500
# Seconds in the Retry-After sent when a notification cannot be verified for a
# reason only a configuration fix can change (wrong environment, rejected
# credentials). Also the minimum gap between two identical refusal log lines, so
# PayPal's retries cannot flood the terminal.
PAYPAL_WEBHOOK_RETRY_AFTER=300

# ---------------------------------------------------------------------------
# Solana Devnet (on-chain settlement + L402 proof anchoring)
# ---------------------------------------------------------------------------
# Which rail pays out automatically:
#   paypal_payouts � PayPal Sandbox Payouts batch (see above)
#   solana-devnet  � a single devnet transaction with both 70/30 legs
# Both stay callable per request via POST /api/payout { "rail": "..." }.
PAYOUT_RAIL=paypal_payouts

SOLANA_ENABLED=true
SOLANA_CLUSTER=devnet
SOLANA_RPC_URL=https://api.devnet.solana.com

# Native SOL by default. Set SOLANA_MINT to an SPL mint (e.g. devnet USDC,
# 4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU) to pay in that token instead.
SOLANA_CURRENCY=SOL
SOLANA_MINT=
SOLANA_DECIMALS=9

# Base units per euro. One euro of attention is worth this many lamports (or
# token base units). Keep it an integer so every payout amount maps to a whole
# number of units with no float drift. 100000000 = 0.1 SOL per euro.
SOLANA_UNITS_PER_EUR=100000000

# Treasury keypair. Accepts a base58 secret key or the JSON byte array written by
# `solana-keygen`. Leave empty and the server generates one, persisting it to
# SOLANA_KEYPAIR_FILE (server/.solana-devnet-keys.json) so the address is stable.
SOLANA_TREASURY_SECRET=

# Optional fixed destinations for the reader and publisher legs. When empty,
# the generated demo keypairs are used (so the transfer is real, on-chain, and
# both legs are visible in the explorer).
SOLANA_READER_ADDRESS=
SOLANA_PUBLISHER_ADDRESS=

# Devnet faucet: keeps the demo self-funding. The public faucet is rate-limited
# per IP, so a failed airdrop is reported with the treasury address to fund.
SOLANA_AIRDROP=true
SOLANA_AIRDROP_SOL=1

# Anchor sha256(preimage) on-chain when an L402 invoice settles.
SOLANA_ANCHOR_PROOFS=true
SOLANA_ANCHOR_TIMEOUT_MS=8000
SOLANA_TIMEOUT_MS=15000

# Guard rail for a single demo payout, and whether to fall back to PayPal when
# the devnet transfer cannot be confirmed.
SOLANA_MAX_PAYOUT=5
SOLANA_FALLBACK_TO_PAYPAL=true

# ---------------------------------------------------------------------------
# Agent cognition   advertiser bid reasoning + attention explanation
# ---------------------------------------------------------------------------
# local | openai | anthropic | gemini.  `local` runs the deterministic reasoner
# in server/src/agent-cognition.js: feature extraction, weighted scoring and
# prose synthesis derived from the actual page context and telemetry. It is not
# a neural network, so nothing here can invent a fact.
AGENT_PROVIDER=local
# Falls back to OPENAI_API_KEY / ANTHROPIC_API_KEY / GEMINI_API_KEY if empty.
# AGENT_API_KEY=
# AGENT_MODEL=
# AGENT_BASE_URL=
AGENT_ENABLED=true
# An advertiser will not spend below this relevance score.
AGENT_MIN_RELEVANCE=0.35
AGENT_TIMEOUT_MS=6000
AGENT_MAX_TOKENS=512
AGENT_TEMPERATURE=0.4
